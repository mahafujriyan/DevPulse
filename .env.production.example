# ─── Vercel Production — paste each into Settings → Environment Variables ─────
# Do NOT commit real passwords. Apply to Production + Preview + Development.

NODE_ENV=production

DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=ReplaceWithAtLeast32CharacterAlphanumericSecretKey
JWT_EXPIRES_IN=7d

# Notes:
# - Neon: Connection pooling ON, hostname must include -pooler
# - Remove channel_binding=require if Neon adds it to the copied URL
# - JWT_SECRET: letters/numbers only (no + or =). Use the SAME value as local .env
# - Vercel: set all 4 variables for Production + Preview + Development
