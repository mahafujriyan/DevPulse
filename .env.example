# Server
PORT=5000
NODE_ENV=development

# Neon PostgreSQL — Dashboard → Connect → Connection pooling ON → copy pooled URI
# Use hostname with -pooler and only ?sslmode=require (remove channel_binding if present)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── VERCEL (same Neon values) ────────────────────────────────────────────────
# DATABASE_URL  = Neon pooled URI → ?sslmode=require only
# JWT_SECRET    = long random string
# JWT_EXPIRES_IN = 7d
# NODE_ENV      = production
