# ─── Local development ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Supabase → Project Settings → Database → Connection string → URI (use pooler for Vercel)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Letters/numbers only (32+ chars). Do NOT use + or = — breaks dotenv parsing
JWT_SECRET=ReplaceWithAtLeast32CharacterAlphanumericSecretKey
JWT_EXPIRES_IN=7d
