# Server
PORT=5000
NODE_ENV=development

# Neon PostgreSQL (Connection pooling ON — use the -pooler hostname)
# Copy from Neon dashboard, then REMOVE channel_binding=require (not supported by node-pg)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Local pgAdmin (backup)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/devpulse

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── VERCEL: Settings → Environment Variables ─────────────────────────────────
# DATABASE_URL  = Neon pooled URI (sslmode=require only, no channel_binding)
# JWT_SECRET    = (long random string)
# JWT_EXPIRES_IN = 7d
# NODE_ENV      = production
