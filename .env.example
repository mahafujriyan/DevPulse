# ─── Local development ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Neon → Connect → Connection pooling ON → copy pooled URI (-pooler host)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Letters/numbers only (32+ chars). Do NOT use + or = — breaks dotenv parsing
JWT_SECRET=ReplaceWithAtLeast32CharacterAlphanumericSecretKey
JWT_EXPIRES_IN=7d
